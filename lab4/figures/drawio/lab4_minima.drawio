        <mxCell id="yes2" parent="1" vertex="1" value="&lt;div&gt;да&lt;/div&gt;" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;fontColor=#111111;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=5;strokeWidth=1;strokeColor=none;fillColor=none;fontSize=16;">
