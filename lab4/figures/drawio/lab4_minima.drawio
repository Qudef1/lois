        <mxCell id="no2" parent="1" vertex="1" value="&lt;div&gt;нет&lt;/div&gt;" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;fontColor=#111111;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=5;strokeWidth=1;strokeColor=none;fillColor=none;fontSize=16;">
          <mxGeometry as="geometry" x="440" y="730" width="55" height="30" />
