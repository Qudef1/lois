<mxfile host="app.diagrams.net" author="Сайковский А. В.; Мяло В. В.; Вашкевич М. В." version="2.0">
  <diagram id="lab4_minima" name="find_minimal_solutions() — все минимальные посылки">
    <mxGraphModel dx="900" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="start" parent="1" vertex="1" value="&lt;div&gt;Начало&lt;/div&gt;" style="shape=mxgraph.flowchart.terminator;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;fontColor=#111111;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=5;strokeWidth=1;">
          <mxGeometry as="geometry" x="360" y="15" width="140" height="50" />
        </mxCell>
        <mxCell id="init" parent="1" vertex="1" value="&lt;div&gt;names = list(upper)&lt;br&gt;lower_bounds = {(0.0, ..., 0.0)}&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;fontColor=#111111;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=5;strokeWidth=1;">
          <mxGeometry as="geometry" x="225" y="100" width="410" height="65" />
        </mxCell>
        <mxCell id="next" parent="1" vertex="1" value="&lt;div&gt;Есть ещё уравнение&lt;br&gt;с target &amp;gt; 0?&lt;/div&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;fontColor=#111111;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=5;strokeWidth=1;fontSize=16;">
          <mxGeometry as="geometry" x="295" y="205" width="270" height="100" />
        </mxCell>
        <mxCell id="witness" parent="1" vertex="1" value="&lt;div&gt;Найти witnesses: r &amp;gt;= target&lt;br&gt;и upper[x] &amp;gt;= target&lt;br&gt;candidates = set()&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;fontColor=#111111;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=5;strokeWidth=1;">
          <mxGeometry as="geometry" x="225" y="355" width="410" height="85" />
        </mxCell>
        <mxCell id="raise" parent="1" vertex="1" value="&lt;div&gt;Для каждого lower и i из witnesses:&lt;br&gt;raised[i] = max(lower[i], target)&lt;br&gt;candidates.add(tuple(raised))&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;fontColor=#111111;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=5;strokeWidth=1;">
          <mxGeometry as="geometry" x="225" y="485" width="410" height="95" />
        </mxCell>
        <mxCell id="limit" parent="1" vertex="1" value="&lt;div&gt;Вариантов &amp;gt; 10 000?&lt;/div&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;fontColor=#111111;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=5;strokeWidth=1;fontSize=16;">
          <mxGeometry as="geometry" x="295" y="620" width="270" height="100" />
        </mxCell>
        <mxCell id="prune" parent="1" vertex="1" value="&lt;div&gt;Оставить в lower_bounds только a,&lt;br&gt;для которых нет other != a&lt;br&gt;с other[i] &amp;lt;= a[i] для всех i&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;fontColor=#111111;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=5;strokeWidth=1;">
          <mxGeometry as="geometry" x="225" y="770" width="410" height="95" />
        </mxCell>
        <mxCell id="return" parent="1" vertex="1" value="&lt;div&gt;return sorted(lower_bounds)&lt;/div&gt;" style="shape=mxgraph.flowchart.terminator;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;fontColor=#111111;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=5;strokeWidth=1;">
          <mxGeometry as="geometry" x="265" y="930" width="330" height="55" />
        </mxCell>
        <mxCell id="error" parent="1" vertex="1" value="&lt;div&gt;Ошибка:&lt;br&gt;слишком много&lt;br&gt;вариантов&lt;/div&gt;" style="shape=mxgraph.flowchart.terminator;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;fontColor=#111111;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=5;strokeWidth=1;">
          <mxGeometry as="geometry" x="600" y="627.5" width="160" height="85" />
        </mxCell>
        <mxCell id="edge1" parent="1" edge="1" source="start" target="init" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#111111;strokeWidth=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge2" parent="1" edge="1" source="init" target="next" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#111111;strokeWidth=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge3" parent="1" edge="1" source="next" target="witness" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#111111;strokeWidth=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge4" parent="1" edge="1" source="witness" target="raise" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#111111;strokeWidth=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge5" parent="1" edge="1" source="raise" target="limit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#111111;strokeWidth=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge6" parent="1" edge="1" source="limit" target="prune" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#111111;strokeWidth=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge7" parent="1" edge="1" source="next" target="return" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#111111;strokeWidth=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="80" y="255" />
              <mxPoint x="80" y="957.5" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge8" parent="1" edge="1" source="prune" target="next" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#111111;strokeWidth=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="430" y="900" />
              <mxPoint x="790" y="900" />
              <mxPoint x="790" y="180" />
              <mxPoint x="430" y="180" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge9" parent="1" edge="1" source="limit" target="error" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#111111;strokeWidth=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="yes1" parent="1" vertex="1" value="&lt;div&gt;да&lt;/div&gt;" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;fontColor=#111111;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=5;strokeWidth=1;strokeColor=none;fillColor=none;fontSize=16;">
          <mxGeometry as="geometry" x="440" y="315" width="55" height="30" />
        </mxCell>
        <mxCell id="no1" parent="1" vertex="1" value="&lt;div&gt;нет&lt;/div&gt;" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;fontColor=#111111;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=5;strokeWidth=1;strokeColor=none;fillColor=none;fontSize=16;">
          <mxGeometry as="geometry" x="215" y="225" width="55" height="30" />
