Источники: авторы lab1.py и lab4.py; образцы figures/drawio первой лабораторной. -->
<mxfile host="app.diagrams.net" author="Сайковский А. В.; Мяло В. В.; Вашкевич М. В." version="2.0">
  <diagram id="lab4_inverse" name="inverse_fuzzy_inference() — обратный вывод">
    <mxGraphModel dx="1000" dy="1020" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="1020" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="start" parent="1" vertex="1" value="&lt;div&gt;Начало&lt;/div&gt;" style="shape=mxgraph.flowchart.terminator;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;fontColor=#111111;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=5;strokeWidth=1;">
          <mxGeometry as="geometry" x="430" y="20" width="140" height="50" />
        </mxCell>
        <mxCell id="init" parent="1" vertex="1" value="&lt;div&gt;targets = dict(conclusion)&lt;br&gt;upper = {x: 1.0 для всех строк R}&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;fontColor=#111111;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=5;strokeWidth=1;">
          <mxGeometry as="geometry" x="300" y="115" width="400" height="70" />
        </mxCell>
        <mxCell id="upper" parent="1" vertex="1" value="&lt;div&gt;Для каждого (x, y, r) из relation:&lt;br&gt;если r &amp;gt; targets[y], то&lt;br&gt;upper[x] = min(upper[x], targets[y])&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;fontColor=#111111;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=5;strokeWidth=1;">
          <mxGeometry as="geometry" x="280" y="235" width="440" height="105" />
        </mxCell>
        <mxCell id="compose" parent="1" vertex="1" value="&lt;div&gt;restored = max_min_composition(&lt;br&gt;list(upper.items()), relation)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;fontColor=#111111;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=5;strokeWidth=1;">
          <mxGeometry as="geometry" x="280" y="395" width="440" height="75" />
        </mxCell>
        <mxCell id="equal" parent="1" vertex="1" value="&lt;div&gt;dict(restored) == targets?&lt;/div&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;fontColor=#111111;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=5;strokeWidth=1;fontSize=16;">
          <mxGeometry as="geometry" x="350" y="530" width="300" height="110" />
        </mxCell>
        <mxCell id="minima" parent="1" vertex="1" value="&lt;div&gt;minima = find_minimal_solutions(&lt;br&gt;relation, conclusion, upper)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;fontColor=#111111;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=5;strokeWidth=1;">
          <mxGeometry as="geometry" x="280" y="720" width="440" height="75" />
        </mxCell>
        <mxCell id="return" parent="1" vertex="1" value="&lt;div&gt;return upper, minima&lt;/div&gt;" style="shape=mxgraph.flowchart.terminator;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;fontColor=#111111;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=5;strokeWidth=1;">
          <mxGeometry as="geometry" x="340" y="865" width="320" height="55" />
        </mxCell>
        <mxCell id="empty" parent="1" vertex="1" value="&lt;div&gt;return upper, None&lt;/div&gt;" style="shape=mxgraph.flowchart.terminator;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;fontColor=#111111;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=5;strokeWidth=1;">
          <mxGeometry as="geometry" x="745" y="720" width="240" height="55" />
        </mxCell>
        <mxCell id="edge1" parent="1" edge="1" source="start" target="init" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#111111;strokeWidth=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge2" parent="1" edge="1" source="init" target="upper" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#111111;strokeWidth=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge3" parent="1" edge="1" source="upper" target="compose" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#111111;strokeWidth=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge4" parent="1" edge="1" source="compose" target="equal" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#111111;strokeWidth=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge5" parent="1" edge="1" source="equal" target="minima" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#111111;strokeWidth=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge6" parent="1" edge="1" source="minima" target="return" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#111111;strokeWidth=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge7" parent="1" edge="1" source="equal" target="empty" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#111111;strokeWidth=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="865" y="585" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="yes" parent="1" vertex="1" value="&lt;div&gt;да&lt;/div&gt;" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;fontColor=#111111;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=5;strokeWidth=1;strokeColor=none;fillColor=none;fontSize=16;">
          <mxGeometry as="geometry" x="510" y="655" width="55" height="30" />
        </mxCell>
        <mxCell id="no" parent="1" vertex="1" value="&lt;div&gt;нет&lt;/div&gt;" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;fontColor=#111111;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=5;strokeWidth=1;strokeColor=none;fillColor=none;fontSize=16;">
          <mxGeometry as="geometry" x="705" y="555" width="55" height="30" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
