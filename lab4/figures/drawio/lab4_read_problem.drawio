<mxfile host="app.diagrams.net" author="Сайковский А. В.; Мяло В. В.; Вашкевич М. В." version="2.0">
  <diagram id="lab4_read_problem" name="read_problem() — ввод отношения и следствия">
    <mxGraphModel dx="1000" dy="940" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="940" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="start" parent="1" vertex="1" value="&lt;div&gt;Начало&lt;/div&gt;" style="shape=mxgraph.flowchart.terminator;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;fontColor=#111111;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=5;strokeWidth=1;">
          <mxGeometry as="geometry" x="430" y="20" width="140" height="50" />
        </mxCell>
        <mxCell id="read" parent="1" vertex="1" value="&lt;div&gt;facts, rules =&lt;br&gt;read_knowledge_base(filename)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;fontColor=#111111;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=5;strokeWidth=1;">
          <mxGeometry as="geometry" x="300" y="115" width="400" height="65" />
        </mxCell>
        <mxCell id="validate" parent="1" vertex="1" value="&lt;div&gt;Проверить строки файла, наличие C,&lt;br&gt;уникальность имён и элементов&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;fontColor=#111111;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=5;strokeWidth=1;">
          <mxGeometry as="geometry" x="300" y="225" width="400" height="80" />
        </mxCell>
        <mxCell id="rule" parent="1" vertex="1" value="&lt;div&gt;Правило задано?&lt;/div&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;fontColor=#111111;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=5;strokeWidth=1;fontSize=16;">
          <mxGeometry as="geometry" x="380" y="355" width="240" height="100" />
        </mxCell>
        <mxCell id="godel" parent="1" vertex="1" value="&lt;div&gt;relation = build_godel_relation(&lt;br&gt;facts[left], facts[right])&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;fontColor=#111111;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=5;strokeWidth=1;">
          <mxGeometry as="geometry" x="70" y="520" width="360" height="80" />
        </mxCell>
        <mxCell id="matrix" parent="1" vertex="1" value="&lt;div&gt;Построить relation из фактов-строк&lt;br&gt;Все факты, кроме C, задают строки R&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;fontColor=#111111;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=5;strokeWidth=1;">
          <mxGeometry as="geometry" x="570" y="520" width="360" height="80" />
        </mxCell>
        <mxCell id="domain" parent="1" vertex="1" value="&lt;div&gt;Проверить: каждая строка R&lt;br&gt;имеет тот же универсум, что C&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;fontColor=#111111;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=5;strokeWidth=1;">
          <mxGeometry as="geometry" x="300" y="710" width="400" height="80" />
        </mxCell>
        <mxCell id="return" parent="1" vertex="1" value="&lt;div&gt;return relation, facts[&amp;#x27;C&amp;#x27;]&lt;/div&gt;" style="shape=mxgraph.flowchart.terminator;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;fontColor=#111111;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=5;strokeWidth=1;">
          <mxGeometry as="geometry" x="330" y="855" width="340" height="55" />
        </mxCell>
        <mxCell id="edge1" parent="1" edge="1" source="start" target="read" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#111111;strokeWidth=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
